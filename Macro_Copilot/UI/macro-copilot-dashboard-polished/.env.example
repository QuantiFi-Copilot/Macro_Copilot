# ============================================================================
# Macro Copilot dashboard — environment variables
# ----------------------------------------------------------------------------
# Copy this file to ``.env`` and adjust values for your local stack.  Vite
# only exposes vars prefixed with ``VITE_`` to the client bundle.
# ============================================================================

# Base URL of the FastAPI backend.  Defaults to localhost:8000 when unset.
VITE_API_BASE_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# Build / Workspace surface (Phase 3)
# ----------------------------------------------------------------------------
# PR C (the visual-fidelity pass) ships the redesigned Build shell as
# the DEFAULT surface at /workspace.  Set this to ``0`` / ``false`` /
# ``off`` to opt back into the legacy WorkspacePage:
#
#   VITE_BUILD_V2=0
#
# Leave it unset (or any other value) and the new shell renders — that's
# the intended state for fresh deployments.
# VITE_BUILD_V2=1
